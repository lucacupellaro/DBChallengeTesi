        </mxCell>

        <!-- LSTM Model -->
        <mxCell id="lstm" value="&lt;b&gt;LSTM&lt;/b&gt;&lt;br&gt;PyTorch&lt;br&gt;&lt;i&gt;Sequenza 22 giorni&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1095" y="310" width="140" height="55" as="geometry"/>
        </mxCell>

        <!-- Mamba Model -->
        <mxCell id="mamba" value="&lt;b&gt;Mamba SSM&lt;/b&gt;&lt;br&gt;State Space Model&lt;br&gt;&lt;i&gt;Sequenza 22 giorni&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1015" y="390" width="140" height="55" as="geometry"/>
        </mxCell>

        <!-- Symbol History Buffer -->
        <mxCell id="sym-hist" value="&lt;b&gt;Symbol History&lt;/b&gt;&lt;br&gt;Buffer in-memory&lt;br&gt;&lt;i&gt;22 giorni per simbolo&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1175" y="175" width="100" height="70" as="geometry"/>
        </mxCell>

        <!-- ML server arrows -->
