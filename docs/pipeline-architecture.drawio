          <mxGeometry x="620" y="40" width="260" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="phase2-label" value="&lt;b&gt;FASE 2: Apache Flink&lt;/b&gt;&lt;br&gt;Stream Processing" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
