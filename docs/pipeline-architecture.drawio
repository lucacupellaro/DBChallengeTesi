        <!-- Arrow reprocessor -> ML server -->
        <mxCell id="a-dlq-r2" value="&lt;font color=&quot;#009900&quot;&gt;HTTP POST&lt;br&gt;(quando ML torna su)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#009900;dashed=1;" edge="1" parent="1" source="dlq-reprocessor" target="ml-server">
