          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="DailyRV" style="fontSize=9;" edge="1" parent="1" source="winday" target="buffer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a8" value="MlRequest" style="fontSize=9;" edge="1" parent="1" source="buffer" target="async-ml">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow async-ml -> kafka-dlq (fallimento) -->
        <mxCell id="a-dlq" value="&lt;font color=&quot;#CC0000&quot;&gt;fallimento&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#CC0000;strokeWidth=2;dashed=1;" edge="1" parent="1" source="async-ml" target="kafka-dlq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ==================== FASE 3: FAULT TOLERANCE ==================== -->
