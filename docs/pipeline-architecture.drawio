        <!-- ==================== FASE 4: STORAGE ==================== -->
        <mxCell id="phase4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="920" y="465" width="360" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="phase4-label" value="&lt;b&gt;FASE 4: Storage&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1020" y="468" width="140" height="25" as="geometry"/>
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;:5433&lt;br&gt;&lt;i&gt;Table: predictions&lt;/i&gt;&lt;br&gt;symbol, ts, rv_*, *_pred" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="490" width="150" height="65" as="geometry"/>
        </mxCell>

        <!-- Arrow ML -> Postgres (via Flink JDBC sink) -->
        <mxCell id="a10" value="&lt;b&gt;JDBC Sink&lt;/b&gt;&lt;br&gt;&lt;i&gt;parallelism=4&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;" edge="1" parent="1" source="async-ml" target="postgres">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="520"/>
              <mxPoint x="1115" y="520"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== DLQ REPROCESSOR ==================== -->
        <mxCell id="dlq-reprocessor" value="&lt;b&gt;DlqReprocessor&lt;/b&gt;&lt;br&gt;Job separato&lt;br&gt;&lt;i&gt;Health check /health&lt;br&gt;ogni 10s fino a risposta&lt;/i&gt;&lt;br&gt;Pausa 500ms tra richieste" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="620" width="190" height="90" as="geometry"/>
        </mxCell>

        <!-- Arrow DLQ topic -> reprocessor -->
