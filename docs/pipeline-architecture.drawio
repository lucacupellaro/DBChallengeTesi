        <!-- ==================== OTTIMIZZAZIONI ==================== -->
        <mxCell id="opt-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;dashed=1;opacity=20;" vertex="1" parent="1">
