          <mxGeometry x="620" y="580" width="660" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="phase3-label" value="&lt;b&gt;FAULT TOLERANCE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="860" y="585" width="180" height="25" as="geometry"/>
        </mxCell>

        <!-- Retry box -->
        <mxCell id="retry-box" value="&lt;b&gt;1. Retry con Backoff&lt;/b&gt;&lt;br&gt;3 tentativi&lt;br&gt;100ms &amp;rarr; 200ms &amp;rarr; 400ms&lt;br&gt;&lt;i&gt;Exponential backoff&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="635" y="620" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- Circuit Breaker box -->
        <mxCell id="cb-box" value="&lt;b&gt;2. Circuit Breaker&lt;/b&gt;&lt;br&gt;Soglia: 5 fallimenti&lt;br&gt;Durata apertura: 30s&lt;br&gt;&lt;i&gt;Blocca richieste inutili&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="825" y="620" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- DLQ box -->
        <mxCell id="dlq-box" value="&lt;b&gt;3. Dead Letter Queue&lt;/b&gt;&lt;br&gt;Topic Kafka &lt;code&gt;ml-failed&lt;/code&gt;&lt;br&gt;&lt;i&gt;Nessuna predizione&lt;br&gt;persa silenziosamente&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1015" y="620" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- Arrows tra fault tolerance -->
        <mxCell id="ft1" value="fallisce" style="strokeColor=#CC0000;fontSize=10;" edge="1" parent="1" source="retry-box" target="cb-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ft2" value="aperto" style="strokeColor=#CC0000;fontSize=10;" edge="1" parent="1" source="cb-box" target="dlq-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HTTP codes -->
        <mxCell id="http-codes" value="&lt;b&gt;Codici HTTP gestiti:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;200&lt;/font&gt; &amp;rarr; OK, predizione salvata&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;500&lt;/font&gt; &amp;rarr; Errore server &amp;rarr; Retry&lt;br&gt;&lt;font color=&quot;#CC6600&quot;&gt;422&lt;/font&gt; &amp;rarr; Dati invalidi &amp;rarr; DLQ subito&lt;br&gt;&lt;font color=&quot;#CC0000&quot;&gt;No response&lt;/font&gt; &amp;rarr; Server down &amp;rarr; Retry" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacing=5;" vertex="1" parent="1">
