          <mxGeometry x="40" y="205" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- Executor/Producer -->
        <mxCell id="executor" value="&lt;b&gt;Executor&lt;/b&gt;&lt;br&gt;Kafka Producer&lt;br&gt;&lt;i&gt;Serializzazione Avro&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
