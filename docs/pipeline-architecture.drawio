        <!-- CSV Files -->
        <mxCell id="csv" value="&lt;b&gt;CSV Giornalieri&lt;/b&gt;&lt;br&gt;(60 asset, tick-level)&lt;br&gt;&lt;i&gt;DateTime, Bid, Ask,&lt;br&gt;Volume, Spread, Symbol&lt;/i&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=0.27;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="160" height="90" as="geometry"/>
        </mxCell>

        <!-- TickReader -->
