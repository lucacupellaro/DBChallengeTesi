        <mxCell id="opt-label" value="&lt;b&gt;OTTIMIZZAZIONI&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="110" y="345" width="180" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="opt1" value="&lt;b&gt;Stato minimale nelle finestre&lt;/b&gt;&lt;br&gt;LogRetAgg: 40 byte (no buffer tick)&lt;br&gt;RvAgg: 12 byte (somma corrente)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="35" y="375" width="220" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="opt2" value="&lt;b&gt;Exactly-Once Semantics&lt;/b&gt;&lt;br&gt;Checkpoint Flink con RETAIN_ON_CANCELLATION" style="text;html=1;align=left;verticalAlign=top;fontSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="35" y="420" width="250" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="opt3" value="&lt;b&gt;Async I/O&lt;/b&gt;&lt;br&gt;AsyncDataStream per ML (non blocca la pipeline)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;spacing=4;" vertex="1" parent="1">
