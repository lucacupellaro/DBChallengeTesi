        <!-- Arrow Flink -> ML Server -->
        <mxCell id="a9" value="&lt;b&gt;HTTP POST&lt;/b&gt;&lt;br&gt;JSON" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#0066CC;" edge="1" parent="1" source="async-ml" target="ml-server">
