          <mxGeometry x="410" y="40" width="180" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="kafka-label" value="&lt;b&gt;MESSAGE BROKER&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="430" y="45" width="140" height="25" as="geometry"/>
