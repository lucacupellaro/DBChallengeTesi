      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TITOLO ==================== -->
        <mxCell id="title" value="&lt;b&gt;Pipeline di Predizione della Volatilita' Realizzata&lt;/b&gt;&lt;br&gt;Architettura end-to-end con fault tolerance" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="350" y="-30" width="580" height="50" as="geometry"/>
